    { "source": "/projects", "destination": "/website/projects.html" },
    { "source": "/projects.html", "destination": "/website/projects.html" },
    { "source": "/faq", "destination": "/website/faq.html" },
    { "source": "/faq.html", "destination": "/website/faq.html" },
    { "source": "/contact", "destination": "/website/contact.html" },
    { "source": "/contact.html", "destination": "/website/contact.html" },
    { "source": "/styles.css", "destination": "/website/styles.css" },
    { "source": "/script.js", "destination": "/website/script.js" }
